diff a/content/browser/web_contents/web_contents_impl_unittest.cc b/content/browser/web_contents/web_contents_impl_unittest.cc	(rejected hunks)
@@ -3773,6 +3773,29 @@ TEST_F(WebContentsImplTest, IsLoadingExcludingAdFrames) {
   ad_frame_navigation->Commit();
   EXPECT_FALSE(contents()->IsLoading());
