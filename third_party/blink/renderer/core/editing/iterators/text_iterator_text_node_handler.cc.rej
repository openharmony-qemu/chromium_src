diff a/third_party/blink/renderer/core/editing/iterators/text_iterator_text_node_handler.cc b/third_party/blink/renderer/core/editing/iterators/text_iterator_text_node_handler.cc	(rejected hunks)
@@ -183,10 +183,14 @@ void TextIteratorTextNodeHandler::HandleTextNodeInRange(const Text* node,
   mapping_units_.clear();
 
