<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ug">
<translation id="2238104961394611930">ئوچۇق • بۇ كېڭەيتمىنىڭ مەنبەسى دەلىللەنمىگەن.</translation>
<translation id="2340553376566028509">ئوچۇق • بۇ كېڭەيتمىنىڭ مەنبەسى دەلىللەنمىگەن.</translation>
<translation id="259482898795437589">{NUM_EXTENSIONS,plural, =1{ئۇنى چىقىرىۋېتىش تەۋسىيە قىلىنىدۇ.}other {چىقىرىۋېتىش تەۋسىيە قىلىنىدۇ.}}</translation>
<translation id="3467729044755133349">ئېتىك • بۇ كېڭەيتمىنىڭ مەنبەسى دەلىللەنمىگەن.</translation>
<translation id="360610872308168435">بۇ كېڭەيتمىنى تەكشۈرۈڭ</translation>
<translation id="483739396253020185">تور كۆرگۈچ بۇ كېڭەيتمىنىڭ مەنبەسىنى دەلىللىيەلمىگەن، خەۋپ بولۇشى مۇمكىن. ئۇنى چىقىرىۋېتىڭ. چىقىرىۋەتسىڭىز، سىز ئاچقان توربېكەتلەردە مەلۇمات (شەخسىي ئۇچۇرلارمۇ شۇنىڭ ئىچىدە) كۆرەلمەيدۇ ۋە ئۆزگەرتەلمەيدۇ.</translation>
<translation id="5123338831436904301">بۇ تەڭشەك ئۆزگەرتىشلىرى تور كۆرگۈچنى قايتا قوزغاتقاندا كۈچكە ئىگە بولىدۇ.</translation>
<translation id="6885534934768077023">ئاگاھلاندۇرۇش: كېڭەيتمىنىڭ تور كۆرۈش پائالىيىتىڭىزنى خاتىرىلىشىنى تور كۆرگۈچ توسالمايدۇ. ئىزسىز ھالەتتە بۇ كېڭەيتمىنى ئىشلەتمەسلىك ئۈچۈن بۇ تاللانمىنى ئېتىپ قويۇڭ.</translation>
<translation id="7597668698051545254">ئېتىك • بۇ كېڭەيتمىنىڭ مەنبەسى دەلىللەنمىگەن.</translation>
</translationbundle>