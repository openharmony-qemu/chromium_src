     deps += [
@@ -3148,10 +3227,24 @@ target(_test_target_type, "net_unittests") {
   configs += [ "//build/config:precompiled_headers" ]
   defines = []
   if (disable_zstd_filter) {
     defines += [ "NET_DISABLE_ZSTD" ]
   }
