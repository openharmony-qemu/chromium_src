diff a/content/browser/digital_credentials/digital_identity_request_impl.cc b/content/browser/digital_credentials/digital_identity_request_impl.cc	(rejected hunks)
@@ -552,17 +552,29 @@ void DigitalIdentityRequestImpl::Get(
