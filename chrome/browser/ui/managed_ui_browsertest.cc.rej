diff a/chrome/browser/ui/managed_ui_browsertest.cc b/chrome/browser/ui/managed_ui_browsertest.cc	(rejected hunks)
@@ -1150,11 +1153,15 @@ IN_PROC_BROWSER_TEST_F(ManagedUiTest, GetManagedUiWebUILabelSupervised) {
   builder.SetIsSupervisedProfile();
   std::unique_ptr<TestingProfile> profile = builder.Build();
 
   if (ExpectManagedUiForSupervisedUsers()) {
     EXPECT_EQ(
+#if BUILDFLAG(ARKWEB_PRIVACY_COMPLIANCE)
+        u"Your <a href=\"https://***\">"
+#else
         u"Your <a href=\"https://familylink.google.com/setting/resource/94\">"
+#endif
         u"browser is managed</a> by your parent",
         GetManagedUiWebUILabel(profile.get()));
   } else {
     EXPECT_TRUE(GetManagedUiWebUILabel(profile.get()).empty());
   }
