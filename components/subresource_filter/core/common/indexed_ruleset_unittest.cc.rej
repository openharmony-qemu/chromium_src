+  EXPECT_EQ(LoadPolicy::DISALLOW,
+            GetLoadCssPolicy("http://example.com?param_blocked2=image1"));
+}
+
+TEST_F(SubresourceFilterIndexedRulesetTest, CssRuleWithDomainWithoutGenericRule) {
