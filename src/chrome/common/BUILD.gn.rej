--- BUILD.gn	2025-10-20 19:52:51.157025564 +0800
+++ BUILD.gn	2025-10-16 15:57:02.050265083 +0800
@@ -281,10 +282,14 @@
 
   if (is_android || enable_library_cdms) {
     public_deps += [ "//components/cdm/common" ]
   }
 
+  if (is_arkweb && arkweb_enable_cdm) {
+    public_deps += [ "//components/cdm/common" ]
+  }
+
   if (enable_ppapi) {
     public_deps += [ "//ppapi/shared_impl" ]
   }
 
   if (enable_extensions_core) {
@@ -629,13 +639,15 @@
       "//chromeos/crosapi/cpp:crosapi_constants",
       "//chromeos/lacros:lacros_paths",
       "//chromeos/startup",
     ]
     public_deps += [ "//chromeos/crosapi/mojom" ]
-  } else if (is_linux || is_chromeos) {
+  } else if (is_linux || is_chromeos || arkweb_asan) {
     sources += [ "chrome_paths_linux.cc" ]
     deps += [ ":channel_info" ]
+  } else if (is_ohos) {
+    sources += [ "//arkweb/chromium_ext/chrome/common/chrome_paths_ohos.cc" ]
   }
   if (is_mac) {
     sources += [ "chrome_paths_mac.mm" ]
   }
   if (is_win) {
@@ -798,10 +810,13 @@
   }
 
   if (enable_bound_session_credentials) {
     enabled_features += [ "enable_bound_session_credentials" ]
   }
+  if (enable_arkweb_ext) {
+    enabled_features += [ "arkweb_ext_exception_list" ]
+  }
 }
 
 mojom("supervised_user_commands_mojom") {
   sources = [ "supervised_user_commands.mojom" ]
 }
