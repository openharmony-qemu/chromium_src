import("//arkweb/build/features/features.gni")
import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core,
       "Cannot depend on extensions because enable_extensions_core=false.")

source_set("messaging") {
  sources = [
    "channel_endpoint.cc",
    "channel_endpoint.h",
    "extension_message_port.cc",
    "extension_message_port.h",
    "message_port.cc",
    "message_port.h",
    "message_service.cc",
    "message_service.h",
    "message_service_bindings.cc",
    "messaging_delegate.cc",
    "messaging_delegate.h",
    "native_message_port.cc",
    "native_message_port.h",
  ]

  if (defined(arkweb_arkweb_extensions) && arkweb_arkweb_extensions) {
    sources += [
      "//arkweb/chromium_ext/extensions/browser/api/messaging/browser_message_port.cc",
      "//arkweb/chromium_ext/extensions/browser/api/messaging/browser_message_port.h",
    ]
  }

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  public_deps = [
    ":native_messaging",
    "//base",
    "//content/public/browser",
    "//extensions/browser:browser_sources",
    "//extensions/common",
    "//extensions/common:mojom",
    "//mojo/public/cpp/bindings",
    "//url",
  ]

  deps = [
    "//components/back_forward_cache",
    "//content/public/common",
    "//extensions/browser/api:extensions_api_client",
    "//extensions/common:common_constants",
    "//extensions/common:mojom_shared",
    "//extensions/common:mojom_shared_cpp_sources",
  ]
}

if (defined(arkweb_arkweb_extensions) && arkweb_arkweb_extensions) {
  source_set("browser_message_port_unittests") {
    testonly = true

    sources = [ "//arkweb/chromium_ext/extensions/browser/api/messaging/browser_message_port_unittest.cc" ]

    deps = [
      ":messaging",
      "//base",
      "//extensions/common",
      "//extensions/common:mojom",
      "//testing/gtest",
    ]
  }
}

# Split up from messaging to avoid circular dependency.
source_set("native_messaging") {
  sources = [
    "native_message_host.cc",
    "native_message_host.h",
    "native_message_port_dispatcher.h",
    "native_messaging_channel.h",
  ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  public_deps = [
    "//base",
    "//ui/gfx:native_widget_types",
  ]
}
