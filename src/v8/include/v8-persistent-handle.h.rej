-  if (this->IsEmpty()) return false;
+  if (this->IsEmpty()) {
+    return false;
+  }
   return I::GetNodeState(this->slot()) == I::kNodeStateIsWeakValue;
 }
 
 template <class T>
 void PersistentBase<T>::Reset() {
-  if (this->IsEmpty()) return;
+  if (this->IsEmpty()) {
+    return;
+  }
   api_internal::DisposeGlobal(this->slot());
   this->Clear();
 }
 
