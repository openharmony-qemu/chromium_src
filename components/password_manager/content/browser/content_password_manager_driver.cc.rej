     return false;
 
+#if BUILDFLAG(ARKWEB_PASSWORD_AUTOFILL)
+  if (!url.SchemeIsHTTPOrHTTPS())
+    return false;
+#endif
+
   return password_manager::bad_message::CheckChildProcessSecurityPolicyForURL(
