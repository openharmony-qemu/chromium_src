--- network_anonymization_key.h	2025-10-20 19:52:56.982204991 +0800
+++ network_anonymization_key.h	2025-10-16 15:55:02.493490038 +0800
@@ -9,10 +9,11 @@
 #include <optional>
 #include <ostream>
 #include <string>
 #include <tuple>
 
+#include "arkweb/build/features/features.h"
 #include "base/unguessable_token.h"
 #include "net/base/net_export.h"
