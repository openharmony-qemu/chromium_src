--- BUILD.gn	2025-10-20 19:52:54.899958757 +0800
+++ BUILD.gn	2025-10-16 15:55:00.136013128 +0800
@@ -6,10 +6,17 @@
 import("//tools/grit/grit_rule.gni")
 import("//tools/grit/repack.gni")
 
 grit("strings") {
   source = "../bluetooth_strings.grd"
+
+  #ifdef arkweb_i18n
+  if (arkweb_i18n) {
+    all_chrome_locales += extra_locales
+  }
+
+  #endif
   outputs =
       [ "grit/bluetooth_strings.h" ] +
       process_file_template(all_chrome_locales,
                             [ "bluetooth_strings_{{source_name_part}}.pak" ])
 }
