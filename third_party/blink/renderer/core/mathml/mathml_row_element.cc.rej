 LayoutObject* MathMLRowElement::CreateLayoutObject(const ComputedStyle& style) {
+#if BUILDFLAG(ARKWEB_ADVANCED_SECURITY_MODE)
+  if (Cssutils::IsMathFormulaDisabledMode()) {
