+  if (arkweb_arkweb_extensions) {
+    import("//arkweb/chromium_ext/chrome/browser/extensions/api/declarative_content/arkweb_extension_declarative_content_ext.gni")
+    sources += arkweb_extensions_declarative_content_ext.sources
+    sources -= arkweb_extensions_declarative_content_ext.sources_del
