@@ -332,10 +344,14 @@ void ExtensionRegistrar::EnableExtension(const ExtensionId& extension_id) {
 
   // This can happen if sync enables an extension that is not installed yet.
   if (!extension)
     return;
 
+#if BUILDFLAG(ARKWEB_LOGGER_REPORT)
