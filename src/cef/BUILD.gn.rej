--- BUILD.gn	2025-10-20 19:52:47.965922285 +0800
+++ BUILD.gn	2025-10-16 15:55:22.330882852 +0800
@@ -940,19 +1014,37 @@
   include_dirs = [
     # Crashpad code uses paths relative to this directory.
     "//third_party/crashpad/crashpad",
   ]
 
+  # OHOS Exteneded sources
+  sources += libcef_arkweb_sources
+  include_dirs += ["//cef/ohos_cef_ext" ]
+
+  deps = [
+      "//components/subresource_filter/content/browser",
+      "//components/subresource_filter/core/browser",
+      "//components/subresource_filter/tools/ruleset_converter:support",
+      "//components/url_pattern_index/proto:url_pattern_index",
+      "//third_party/protobuf:protobuf_lite",
+  ]
+
   public_deps = [
     # Bring in feature flag defines.
     "//cef/libcef/features",
     # Support relative include paths.
     "//base",
     "//third_party/abseil-cpp:absl",
   ]
+  if (arkweb_unittests) {
+    public_deps += [
+      # Support ohos_nweb include paths.
+      "//ohos_nweb:nweb_sources",
+    ]
+  }
 
-  deps = [
+  deps += [
     ":cef_make_headers",
     "libcef/common/mojom",
 
     ":libcef_static_unittested",
 
@@ -1448,22 +1768,10 @@
       # Increase the initial stack size to 8MiB from the default 1MiB.
       ldflags = [ "/STACK:0x800000" ]
     }
   }
 
-  # Build using the minimum C++ version supported by the CEF binary distribution.
-  # Chromium (and libcef) may build with a newer C++ version so this helps to
-  # avoid accidental usage of new/unsupported language features in sample apps.
-  # For Chromium defaults see //build/config/compiler/BUILD.gn.
-  if (is_win) {
-    cflags_cc = [ "/std:c++17" ]
-  } else {
-    cflags_cc = [ "-std=c++17" ]
-  }
-  if (is_mac) {
-    cflags_objcc = [ "-std=c++17" ]
-  }
 }
 
 # libcef_dll_wrapper target.
 static_library("libcef_dll_wrapper") {
   sources = includes_common +
@@ -1528,10 +1839,16 @@
   source = "libcef/resources/cef_strings.grd"
   outputs = [
     "grit/cef_strings.h",
   ]
   all_locales = platform_pak_locales + [ "fake-bidi" ]
+
+  #ifdef arkweb_i18n
+  if (arkweb_i18n) {
+    all_locales += extra_locales
+  }
+
   foreach(locale, all_locales) {
     outputs += [ "cef_strings_${locale}.pak" ]
   }
 }
 
@@ -1894,31 +2221,39 @@
       # yet.
       ldflags = [ "/pdbpagesize:8192" ]
     }
   }
 
-  shared_library("libcef") {
-    # Necessary because the libcef_test_support target is testonly.
-    testonly = true
-
+  if (is_component_build) {
+    shared_library("libarkweb_engine") {
+      deps = [ "//base" ]
+    }
+  } else {
+    shared_library("libarkweb_engine") {
+      configs += [ "//arkweb/build/config/sanitizers:cfi_config" ]
+      defines = [ "LOGGING_TAG=\"cef#\"" ]
     sources = includes_common +
               gypi_paths.autogen_cpp_includes +
               gypi_paths2.includes_capi +
               gypi_paths.autogen_capi_includes +
               gypi_paths2.libcef_sources_common +
               gypi_paths.autogen_library_side
 
-    deps = [
-      ":libcef_static",
-      ":libcef_test_support",
-    ]
+      sources += [ "libcef/browser/test/test_helpers_impl.cc" ]
+
+      deps = [ ":libcef_static" ]
 
     configs += [
       ":libcef_autogen_config",
       ":pdb_larger_than_4gb",
     ]
 
+      deps += [ "//ohos_nweb:nweb_sources" ]
+      if (is_arkweb_ext) {
+        deps += [ "//ohos_nweb_ex:nweb_ex" ]
+      }
+
     if (is_win) {
       sources += includes_win + [
         "libcef_dll/libcef_dll.rc",
       ]
 
