                                           public IsolationKeyProvider {
  public:
+  friend class GpuChannelExt;
+
   GpuChannel(const GpuChannel&) = delete;
   GpuChannel& operator=(const GpuChannel&) = delete;
   ~GpuChannel() override;
 
+  virtual gpu::GpuChannelExt* AsGpuChannelExt() {
+    return nullptr;
+  }
+
