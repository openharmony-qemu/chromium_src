--- BUILD.gn	2025-10-20 19:52:55.399741705 +0800
+++ BUILD.gn	2025-10-16 15:55:00.479645356 +0800
@@ -8,10 +8,17 @@
 
 assert(enable_extensions_core)
 
 grit("strings") {
   source = "extensions_strings.grd"
+
+  #ifdef arkweb_i18n
+  if (arkweb_i18n) {
+    all_chrome_locales += extra_locales
+  }
+
+  #endif
   outputs =
       [ "grit/extensions_strings.h" ] +
       process_file_template(all_chrome_locales,
                             [ "extensions_strings_{{source_name_part}}.pak" ])
 }
