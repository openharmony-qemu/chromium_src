// HarmonyOS Extension Agent API (hwext.agent)
// Event-only namespace for receiving targeted browser/OS condition signals.
// Fire-and-forget: no prompt, screenshot, callback, ack, or completion stream.

[implemented_in="arkweb/chromium_ext/chrome/browser/extensions/api/hwext_agent/hwext_agent_api.h"]
namespace hwext.agent {

  // The source of a trigger signal.
  enum TriggerSource {
    browser,
    os
  };

  // A fire-and-forget condition signal broadcast to all enabled agent
  // extensions holding the "hwext.agent" permission. Contains no prompt,
  // screenshot, file token, secrets, callback, ack, completion stream, or
  // arbitrary JSON string payload.
  dictionary AgentTriggerEvent {
    // Opaque unique identifier for this trigger (<=512 UTF-8 bytes).
    DOMString triggerId;

    // Documented identifier(<=512 UTF-8 bytes).
    DOMString type;

    // Source of the trigger signal.
    TriggerSource source;

    // Optional tab reference. Safe reference only; no implicit host
    // permission, activeTab, user gesture, or page snapshot.
    long? tabId;

    // Unix epoch milliseconds.
    double timestamp;
  };

  interface Events {
    // Receives a fire-and-forget browser/OS condition signal. Broadcast to
    // all enabled extensions holding the "hwext.agent" permission.
    static void onTriggered(AgentTriggerEvent event);
  };
};
