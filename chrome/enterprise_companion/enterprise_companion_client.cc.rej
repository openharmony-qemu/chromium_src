diff a/chrome/enterprise_companion/enterprise_companion_client.cc b/chrome/enterprise_companion/enterprise_companion_client.cc	(rejected hunks)
@@ -101,12 +101,20 @@ void ConnectWithRetries(
                "The service could not be launched.";
     std::move(callback).Run({});
     return;
   }
 
+#if BUILDFLAG(IS_WIN)
+  mojo::NamedPlatformChannel::Options options;
+  options.server_name = server_name;
+  options.verify_server_privilege = true;
+  mojo::PlatformChannelEndpoint endpoint =
+      named_mojo_ipc_server::ConnectToServer(options);
+#else
   mojo::PlatformChannelEndpoint endpoint =
       named_mojo_ipc_server::ConnectToServer(server_name);
+#endif
   if (endpoint.is_valid()) {
     std::move(callback).Run(std::move(endpoint));
     return;
   }
 
@@ -130,11 +138,18 @@ void ConnectToServer(
     const mojo::NamedPlatformChannel::ServerName& server_name) {
   base::ThreadPool::PostTask(
       FROM_HERE, {base::MayBlock()},
       base::BindOnce(
           [](const mojo::NamedPlatformChannel::ServerName& server_name) {
+#if BUILDFLAG(IS_WIN)
+            mojo::NamedPlatformChannel::Options options;
+            options.server_name = server_name;
+            options.verify_server_privilege = true;
+            return named_mojo_ipc_server::ConnectToServer(options);
+#else
             return named_mojo_ipc_server::ConnectToServer(server_name);
+#endif
           },
           server_name)
           .Then(base::BindPostTaskToCurrentDefault(
               base::BindOnce(&OnEndpointReceived, std::move(callback)))));
 }
