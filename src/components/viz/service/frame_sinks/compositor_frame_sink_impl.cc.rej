--- compositor_frame_sink_impl.cc	2025-10-20 19:52:54.138416817 +0800
+++ compositor_frame_sink_impl.cc	2025-10-16 15:54:59.236975324 +0800
@@ -147,15 +155,24 @@
 
 void CompositorFrameSinkImpl::SetAutoNeedsBeginFrame() {
   support_->SetAutoNeedsBeginFrame();
 }
 
+#if BUILDFLAG(ARKWEB_VSYNC_SCHEDULE)
+void CompositorFrameSinkImpl::OnSetBypassVsyncCondition(int32_t condition) {
+  compositor_frame_sink_impl_util_->OnSetBypassVsyncCondition(condition);
+}
+#endif
+
 void CompositorFrameSinkImpl::SubmitCompositorFrame(
     const LocalSurfaceId& local_surface_id,
     CompositorFrame frame,
     std::optional<HitTestRegionList> hit_test_region_list,
     uint64_t submit_time) {
+#if BUILDFLAG(ARKWEB_REPORT_SYS_EVENT)
+  compositor_frame_sink_impl_util_->SubmitCompositorFrameUtils(frame.metadata);
+#endif
   // Non-root surface frames should not have display transform hint.
   DCHECK_EQ(gfx::OVERLAY_TRANSFORM_NONE, frame.metadata.display_transform_hint);
   SubmitCompositorFrameInternal(local_surface_id, std::move(frame),
                                 std::move(hit_test_region_list), submit_time,
                                 SubmitCompositorFrameSyncCallback());
