diff a/content/browser/renderer_host/media/service_video_capture_device_launcher.cc b/content/browser/renderer_host/media/service_video_capture_device_launcher.cc	(rejected hunks)
@@ -87,10 +88,14 @@ void ServiceVideoCaptureDeviceLauncher::LaunchDeviceAsync(
     Callbacks* callbacks,
     base::OnceClosure done_cb) {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   DCHECK(state_ == State::READY_TO_LAUNCH);
 
+#if BUILDFLAG(ARKWEB_WEBRTC)
+  LOG(INFO) << "ServiceVideoCaptureDeviceLauncher::LaunchDeviceAsync";
+#endif // BUILDFLAG(ARKWEB_WEBRTC)
+
   auto scoped_trace = ScopedCaptureTrace::CreateIfEnabled(
       "ServiceVideoCaptureDeviceLauncher::LaunchDeviceAsync");
 
   // This launcher only supports MediaStreamType::DEVICE_VIDEO_CAPTURE.
   CHECK_EQ(stream_type, blink::mojom::MediaStreamType::DEVICE_VIDEO_CAPTURE);
