diff a/components/omnibox/browser/search_suggestion_parser_unittest.cc b/components/omnibox/browser/search_suggestion_parser_unittest.cc	(rejected hunks)
@@ -268,10 +268,41 @@ TEST(SearchSuggestionParserTest, ParseSuggestResults) {
   ASSERT_EQ(1U, results.gws_event_id_hashes.size());
