diff a/gpu/ipc/service/gpu_channel_shared_image_interface.cc b/gpu/ipc/service/gpu_channel_shared_image_interface.cc	(rejected hunks)
@@ -99,10 +105,66 @@ GpuChannelSharedImageInterface::CreateSharedImageForAndroidVideo(
