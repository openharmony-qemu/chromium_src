_colors_info_tool =
    "//chrome/browser/new_tab_page/chrome_colors:generate_colors_info"
if (is_ohos) {
  # Build-time generators run on the host, not inside the OHOS guest.
  _colors_info_tool =
      "//chrome/browser/new_tab_page/chrome_colors:generate_colors_info($host_toolchain)"
}

source_set("theme_color_picker") {
  sources = [
    "customize_chrome_colors.cc",
    "customize_chrome_colors.h",
  ]
  deps = [
    "//chrome/browser/new_tab_page/chrome_colors:generate_chrome_colors_info",
    _colors_info_tool,
    "//ui/base/mojom",
    "//ui/color",
  ]
}
