diff a/components/js_injection/common/interfaces.mojom b/components/js_injection/common/interfaces.mojom	(rejected hunks)
@@ -32,10 +32,36 @@ struct DocumentStartJavaScript {
   int32 script_id;
   mojo_base.mojom.String16 script;
   origin_matcher.mojom.OriginMatcher origin_matcher;
 };
 
+// DocumentJavaScriptRegexRules struct contains the JavaScript snippet |script| and
+// the regex rules |script_regex_rules|. We will run the script if the frame's
+// regex rules matches any rules in the |script_regex_rules|.
+[EnableIf=arkweb_jsproxy]
+struct ScriptRegexRule {
+  mojo_base.mojom.String16 second_level_domain;
+  mojo_base.mojom.String16 rule;
+};
+
+[EnableIf=arkweb_jsproxy]
+struct DocumentJavaScriptRegexRules {
+  int32 script_id;
+  mojo_base.mojom.String16 script;
+  array<ScriptRegexRule> script_regex_rules;
+};
+
+// DocumentEndJavaScript struct contains the JavaScript snippet |script| and
+// the corresponding |origin_matcher|. We will run the script if the frame's
+// origin matches any rules in the |origin_matcher| when document end.
+[EnableIf=arkweb_js_on_document_end]
+struct DocumentEndJavaScript {
+  int32 script_id;
+  mojo_base.mojom.String16 script;
+  origin_matcher.mojom.OriginMatcher origin_matcher;
+};
+
 // The ArrayBuffer arm of the JsWebMessage union below, which contains the
 // ArrayBuffer payload sent between JavaScript and browser.
 struct JsWebMessageArrayBufferValue {
   mojo_base.mojom.BigBuffer array_buffer_value;
   // If is_resizable_by_user_javascript is false, then max_byte_length is
@@ -99,6 +125,70 @@ interface JsCommunication {
   // allowed_origin_rules.
   AddDocumentStartScript(js_injection.mojom.DocumentStartJavaScript script);
 
   // Called from browser, to remove the script by the given script_id.
   RemoveDocumentStartScript(int32 script_id);
+
+  // Called from browser, to add regex rules for a frame to run at document start stage.
+  [EnableIf=arkweb_jsproxy]
+  AddDocumentStartScriptRegexRules(DocumentJavaScriptRegexRules script_regex_rules);
+
+  // Called from browser, to add a script for a frame to run at document end
+  // stage. The script will run only if the frame's origin matches any of the
+  // allowed_origin_rules.
+  [EnableIf=arkweb_js_on_document_end]
+  AddDocumentEndScript(js_injection.mojom.DocumentEndJavaScript script);
+  // Called from browser, to remove the script by the given script_id.
+  [EnableIf=arkweb_js_on_document_end]
+  RemoveDocumentEndScript(int32 script_id);
+
+  // Called from browser, to add regex rules for a frame to run at document end stage.
+  [EnableIf=arkweb_js_on_document_end]
+  AddDocumentEndScriptRegexRules(DocumentJavaScriptRegexRules script_regex_rules);
+
+  // Called from browser, to add a script for a frame to run at head element ready
+  // stage. The script will run only if the frame's origin matches any of the
+  // allowed_origin_rules.
+  [EnableIf=arkweb_jsproxy]
+  AddHeadReadyScript(js_injection.mojom.DocumentStartJavaScript script);
+
+  // Called from browser, to remove the script by the given script_id.
+  [EnableIf=arkweb_jsproxy]
+  RemoveHeadReadyScript(int32 script_id);
+
+  // Called from browser, to add regex rules for a frame to run at head element ready stage.
+  [EnableIf=arkweb_jsproxy]
+  AddHeadReadyScriptRegexRules(DocumentJavaScriptRegexRules script_regex_rules);
+
+  // Called from browser, to replace scripts for a frame to run at document start
+  // stage. The scripts will run only if the frame's origin matches any of the
+  // allowed_origin_rules.
+  [EnableIf=arkweb_jsproxy]
+  AddPendingJavascriptAtDocumentStart(js_injection.mojom.DocumentStartJavaScript script,
+    DocumentJavaScriptRegexRules script_regex_rules);
+
+  // Called from browser, to replace scripts for a frame to run at document end
+  // stage. The scripts will run only if the frame's origin matches any of the
+  // allowed_origin_rules.
+  [EnableIf=arkweb_jsproxy]
+  AddPendingJavascriptAtDocumentEnd(js_injection.mojom.DocumentEndJavaScript script,
+    DocumentJavaScriptRegexRules script_regex_rules);
+
+  // Called from browser, to replace scripts for a frame to run at head element ready
+  // stage. The scripts will run only if the frame's origin matches any of the
+  // allowed_origin_rules.
+  [EnableIf=arkweb_jsproxy]
+  AddPendingJavascriptAtHeadReady(js_injection.mojom.DocumentStartJavaScript script,
+    DocumentJavaScriptRegexRules script_regex_rules);
+
+  // Called from browser, to Commit document start javaScript
+  [EnableIf=arkweb_jsproxy]
+  CommitPendingJavascriptsAtDocumentStart();
+
+  // Called from browser, to Commit document end javaScript
+  [EnableIf=arkweb_jsproxy]
+  CommitPendingJavascriptsAtDocumentEnd();
+
+  // Called from browser, to Commit head ready javaScript
+  [EnableIf=arkweb_jsproxy]
+  CommitPendingJavascriptsAtHeadReady();
 };
