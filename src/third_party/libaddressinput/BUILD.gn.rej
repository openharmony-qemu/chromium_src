+  } else {
   defines = [ "I18N_ADDRESS_VALIDATION_DATA_URL=\"https://chromium-i18n.appspot.com/ssl-aggregate-address/\"" ]
+  }
   include_dirs = [ "src/cpp/include" ]
 }
 
