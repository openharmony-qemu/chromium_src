--- network_session_configurator.cc	2025-10-20 19:52:53.161967776 +0800
+++ network_session_configurator.cc	2025-10-16 15:54:57.016068660 +0800
@@ -846,15 +858,25 @@
         command_line.GetSwitchValueASCII(switches::kHostRules));
   }
 }
 
 net::URLRequestContextBuilder::HttpCacheParams::Type ChooseCacheType() {
+#if BUILDFLAG(ARKWEB_CACHE)
+  if ((*base::CommandLine::ForCurrentProcess())
+          .HasSwitch(switches::kOhosHttpCacheSimple)) {
+    return net::URLRequestContextBuilder::HttpCacheParams::DISK_SIMPLE;
+  } else {
+    return net::URLRequestContextBuilder::HttpCacheParams::DISK_BLOCKFILE;
+  }
+#else
+
   if constexpr (disk_cache::IsSimpleBackendEnabledByDefaultPlatform()) {
     return net::URLRequestContextBuilder::HttpCacheParams::DISK_SIMPLE;
   }
   if (disk_cache::InSimpleBackendExperimentGroup()) {
     return net::URLRequestContextBuilder::HttpCacheParams::DISK_SIMPLE;
   }
   return net::URLRequestContextBuilder::HttpCacheParams::DISK_BLOCKFILE;
+#endif // BUILDFLAG(ARKWEB_CACHE)
 }
 
 }  // namespace network_session_configurator
