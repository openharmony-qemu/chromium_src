+    all_chrome_locales += extra_locales
+  }
+
+  #endif
   foreach(locale, all_chrome_locales) {
     outputs += [ "address_input_strings_$locale.pak" ]
   }
 
   configs = [ ":internal_config" ]
 }
 
 config("libaddressinput_config") {
+  if (arkweb_privacy_compliance) {
