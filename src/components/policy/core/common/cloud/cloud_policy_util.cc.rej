--- cloud_policy_util.cc	2025-10-20 19:52:53.390072886 +0800
+++ cloud_policy_util.cc	2025-10-16 15:54:57.275790693 +0800
@@ -86,11 +86,11 @@
 
 namespace em = enterprise_management;
 
 std::string GetMachineName() {
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS_LACROS) || \
-    BUILDFLAG(IS_FUCHSIA)
+    BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_OHOS)
   char hostname[HOST_NAME_MAX];
   if (gethostname(hostname, HOST_NAME_MAX) == 0)  // Success.
     return hostname;
   return std::string();
 #elif BUILDFLAG(IS_IOS)
@@ -207,10 +207,13 @@
   return creds->pw_name;
 #elif BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_FUCHSIA)
   // TODO(crbug.com/40200780): This should be fully implemented when there is
   // support in fuchsia.
   return std::string();
+#elif BUILDFLAG(IS_OHOS)
+  // need to call ets to get ohos username
+  return std::string("ohos-anonymous");
 #else
   NOTREACHED_IN_MIGRATION();
   return std::string();
 #endif
 }
