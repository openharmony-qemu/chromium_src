+import("//arkweb/build/features/features.gni")
 import("//build/config/features.gni")
 import("//mojo/public/tools/bindings/mojom.gni")
 import("//net/features.gni")
 import("//services/network/public/cpp/features.gni")
 import("//testing/libfuzzer/fuzzer_test.gni")
+if (is_arkweb) {
+  import("//arkweb/chromium_ext/chromium_ext.gni")
+}
 
 component("network_service") {
   sources = [
     "accept_ch_frame_interceptor.cc",
     "accept_ch_frame_interceptor.h",
@@ -371,17 +383,32 @@ component("network_service") {
     "//services/service_manager/public/cpp",
     "//services/service_manager/public/mojom",
     "//third_party/liburlpattern",
     "//third_party/re2",
     "//url",
+    "//arkweb/chromium_ext/services/network:network_service",
+  ]
+  if (defined(is_arkweb) && is_arkweb) {
+    deps += [
+      "//base:base_static",
   ]
+  }
 
-  if (is_linux || is_chromeos) {
+  if (is_linux || is_chromeos || is_ohos) {
     deps += [
       ":network_sandbox_hook",
       "//sandbox/linux:sandbox_services",  # TODO(crbug.com/40220505): remove.
     ]
+    if (is_ohos) {
+      deps += [ "//cef/libcef/features:deps" ]
+    }
+
+    configs += [ "//cef/libcef/features:config" ]
+  }
+
+  if (arkweb_prp_preload) {
+    deps += [ "//arkweb/chromium_ext/services/network/prp_preload:prp_preload", ]
   }
 
   public_deps = [ "//services/network/public/cpp:buildflags" ]
 
   if (is_ct_supported) {
@@ -621,17 +653,29 @@ source_set("tests") {
       "sct_auditing/sct_auditing_reporter_unittest.cc",
     ]
     deps += [ "//components/certificate_transparency" ]
   }
 
+  if (arkweb_prp_preload) {
+    deps += [ "//arkweb/chromium_ext/services/network/prp_preload:prp_preload", ]
+  }
+
   if (use_blink) {
     deps += [
       "//services/proxy_resolver:lib",
       "//third_party/blink/public/common:preloading_headers",
     ]
   }
 
+  if (arkweb_test) {
+    sources += [
+      "//arkweb/chromium_ext/services/network/network_service_network_delegate_ext_unittest.cc",
+      "//arkweb/chromium_ext/services/network/sec_header_helpers_ext_unittest.cc",
+      "//arkweb/chromium_ext/services/network/tests/url_loader_ext_unittests.cc",
+    ]
+  }
+
   # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
   # enable the diagnostic by removing this line.
   configs += [ "//build/config/compiler:no_exit_time_destructors" ]
 }
 
