     # Clangd does not detect BUILDFLAG_INTERNAL_* indirect usage, so mark the
     # header as "always_keep" to avoid "unused include" warning.
     output_file.write('// IWYU pragma: always_keep\n\n')
 
+    if options.for_arkweb:
