+# arkweb_useragent
+import("//build/config/python.gni")
 static_library("embedder_support") {
   sources = [
     "pref_names.h",
     "switches.cc",
     "switches.h",
   ]
 }
 
+# arkweb_useragent
+action("make_ohos_arkweb_version") {
+  script = "//arkweb/chromium_ext/components/embedder_support/make_ohos_arkweb_version.py"
+  args = [
+    "--input_file",
+    rebase_path("//third_party/ohos_nweb_hap/AppScope/app.json5.template"),
+    "--output_file",
+    rebase_path("$target_gen_dir/arkweb_version.h", root_build_dir),
+  ]
+  outputs = [ "$target_gen_dir/arkweb_version.h" ]
+  deps = [ "//third_party/ohos_nweb_hap:arkwebcore_hap_app_json5" ]
+}
+
+import("//arkweb/build/features/features.gni")
+
 # Target for general utilities that are only used in the browser process.
 static_library("browser_util") {
   sources = [
     "content_settings_utils.cc",
     "content_settings_utils.h",
@@ -34,10 +51,14 @@
     "//components/version_info",
     "//content/public/browser",
     "//services/device/public/cpp:device_features",
     "//services/device/public/cpp/geolocation:buildflags",
   ]
+
+  if (arkweb_useragent) {
+    deps += [ ":make_ohos_arkweb_version" ]
+  }
 }
 
