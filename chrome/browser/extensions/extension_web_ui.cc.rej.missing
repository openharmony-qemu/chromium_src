diff a/chrome/browser/extensions/extension_web_ui.cc b/chrome/browser/extensions/extension_web_ui.cc
--- a/chrome/browser/extensions/extension_web_ui.cc
+++ b/chrome/browser/extensions/extension_web_ui.cc
@@ -493,11 +493,15 @@ const extensions::Extension* ExtensionWebUI::GetExtensionControllingURL(
   GURL mutable_url(url);
   if (!HandleChromeURLOverride(&mutable_url, browser_context))
     return nullptr;
 
   DCHECK_NE(url, mutable_url);
-  DCHECK(mutable_url.SchemeIs(extensions::kExtensionScheme));
+  DCHECK(mutable_url.SchemeIs(extensions::kExtensionScheme)
+#if BUILDFLAG(ARKWEB_ARKWEB_EXTENSIONS)
+         || mutable_url.SchemeIs(extensions::kArkwebExtensionScheme)
+#endif
+  );
 
   const extensions::Extension* extension =
       extensions::ExtensionRegistry::Get(browser_context)
           ->enabled_extensions()
           .GetByID(mutable_url.GetHost());
