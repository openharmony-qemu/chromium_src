diff a/base/i18n/rtl.cc b/base/i18n/rtl.cc	(rejected hunks)
@@ -28,10 +28,11 @@
 
 #if BUILDFLAG(IS_IOS)
 #include "base/debug/crash_logging.h"
 #include "base/ios/ios_util.h"
