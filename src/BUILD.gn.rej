--- BUILD.gn	2025-10-20 19:52:45.937020047 +0800
+++ BUILD.gn	2025-10-16 15:54:54.081775126 +0800
@@ -98,14 +102,16 @@
     } else {
       deps = []
     }
   } else {
     deps = [
+      "//arkweb/build:arkweb_test_targets",
       "//base:base_perftests",
       "//base:base_unittests",
       "//codelabs",
       "//components:components_unittests",
+      "//ohos_nweb/test:ohos_nweb_unittests",
       "//components/gwp_asan:gwp_asan_unittests",
       "//infra/orchestrator:orchestrator_all",
       "//net:net_unittests",
       "//sandbox:sandbox_unittests",
       "//services:services_unittests",
@@ -122,15 +128,32 @@
       "//third_party/rapidhash:rapidhash_fuzztests",
       "//tools/binary_size:binary_size_trybot_py",
       "//tools/ipc_fuzzer:ipc_fuzzer_all",
       "//tools/metrics:metrics_metadata",
       "//ui/base:ui_base_unittests",
+      "//ui/color:color_unittests",
       "//ui/gfx:gfx_unittests",
       "//ui/tests:ui_unittests",
       "//url:url_unittests",
     ]
 
+    if (defined(arkweb_nweb_ex) && arkweb_nweb_ex) {
+      deps += [
+        "//ohos_browser_shell",
+        "//ohos_nweb_ex/browser_service",
+        "//ohos_nweb_ex/test:ohos_nweb_ex_unittests",
+        "//third_party/ohos_nweb_hap",
