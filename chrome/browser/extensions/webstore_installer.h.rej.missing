   void ReportSuccess();
@@ -171,10 +184,14 @@ class WebstoreInstaller : public ExtensionRegistryObserver,
   base::OneShotTimer download_progress_timer_;
   std::unique_ptr<InstallApproval> approval_;
   GURL download_url_;
   scoped_refptr<CrxInstaller> crx_installer_;
 
+#if BUILDFLAG(ARKWEB_ARKWEB_EXTENSIONS)
+  int webstore_type_ = kWebStoreTypeDefault;
