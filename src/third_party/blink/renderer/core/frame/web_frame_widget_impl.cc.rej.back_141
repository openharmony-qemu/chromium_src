--- web_frame_widget_impl.cc	2025-10-20 19:53:00.402209945 +0800
+++ web_frame_widget_impl.cc	2025-10-16 16:07:39.408937111 +0800
@@ -935,15 +937,23 @@
 
   // If there is a popup open, it should be the one processing the event,
   // not the page.
   scoped_refptr<WebPagePopupImpl> page_popup = View()->GetPagePopup();
   if (page_popup) {
+#if BUILDFLAG(ARKWEB_INPUT_EVENTS)
+    WebInputEventResult event_result = page_popup->HandleKeyEvent(event);
+#else
     page_popup->HandleKeyEvent(event);
+#endif
     if (event.GetType() == WebInputEvent::Type::kRawKeyDown) {
       suppress_next_keypress_event_ = true;
     }
+#if BUILDFLAG(ARKWEB_INPUT_EVENTS)
+    return event_result;
+#else
     return WebInputEventResult::kHandledSystem;
+#endif
   }
 
   auto* frame = DynamicTo<LocalFrame>(FocusedCoreFrame());
   if (!frame)
     return WebInputEventResult::kNotHandled;
