diff a/extensions/common/features/simple_feature.cc b/extensions/common/features/simple_feature.cc	(rejected hunks)
@@ -596,10 +596,23 @@ void SimpleFeature::set_matches(
   matches_.ClearPatterns();
   for (const auto* pattern : matches)
     matches_.AddPattern(URLPattern(URLPattern::SCHEME_ALL, pattern));
 }
 
+#if BUILDFLAG(ARKWEB_ARKWEB_EXTENSIONS)
+void SimpleFeature::add_matches(const GURL& url, std::string_view pattern) {
+  if (matches_.MatchesAllURLs()) {
+    return;
+  }
+ 
+  if (matches_.MatchesURL(url)) {
+    LOG(INFO) << "add pattern,name is " << name();
+    matches_.AddPattern(URLPattern(URLPattern::SCHEME_ALL, pattern));
+  }
+}
+#endif
+
