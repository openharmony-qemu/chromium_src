 void SafeBrowsingServiceImpl::Start() {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
 
+#if BUILDFLAG(ARKWEB_NETWORK_LOAD)
+  return;
+#endif
+
   if (!enabled_) {
     enabled_ = true;
     services_delegate_->StartOnUIThread(
         g_browser_process->shared_url_loader_factory(), GetV4ProtocolConfig());
   }
