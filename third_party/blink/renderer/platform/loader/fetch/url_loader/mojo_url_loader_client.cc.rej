   DCHECK(!has_received_response_head_);
   if (freeze_mode_ == LoaderFreezeMode::kBufferIncoming) {
+#if BUILDFLAG(ARKWEB_BFCACHE)
+    if (!(base::CommandLine::ForCurrentProcess()->HasSwitch(
