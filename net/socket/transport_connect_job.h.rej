+#endif
  private:
   friend class TransportConnectSubJob;
+  friend class ArkWebTransportConnectJobExt;
 
   enum State {
     STATE_RESOLVE_HOST,
     STATE_RESOLVE_HOST_COMPLETE,
     STATE_RESOLVE_HOST_CALLBACK_COMPLETE,
@@ -231,10 +277,26 @@ class NET_EXPORT_PRIVATE TransportConnectJob : public ConnectJob {
