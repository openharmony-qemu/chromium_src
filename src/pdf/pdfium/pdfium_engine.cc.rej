   gfx::Rect right;
+
+#if BUILDFLAG(ARKWEB_PDF)
+  if (!client_) {
+    LOG(ERROR) << __func__ << ", PDF client_ is null.";
+    return;
+  }
+  gfx::Rect clipped_selection_bounds(0, 0, 0, 0);
+  // When searching for results, do not calculate the selection position to
