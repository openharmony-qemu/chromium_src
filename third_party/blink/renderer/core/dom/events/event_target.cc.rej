diff a/third_party/blink/renderer/core/dom/events/event_target.cc b/third_party/blink/renderer/core/dom/events/event_target.cc	(rejected hunks)
@@ -503,16 +503,24 @@ void EventTarget::SetDefaultAddEventListenerOptions(
 
