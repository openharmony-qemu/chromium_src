--- BUILD.gn	2025-10-20 19:52:54.923758070 +0800
+++ BUILD.gn	2025-10-16 15:55:00.159987469 +0800
@@ -7,10 +7,17 @@
 import("//tools/grit/repack.gni")
 
 grit("strings") {
   source = "../fido_strings.grd"
   outputs = [ "grit/fido_strings.h" ]
+
+  #ifdef arkweb_i18n
+  if (arkweb_i18n) {
+    all_chrome_locales += extra_locales
+  }
+
+  #endif
   foreach(locale, all_chrome_locales) {
     outputs += [ "fido_strings_$locale.pak" ]
   }
 }
 
