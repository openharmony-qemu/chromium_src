 // as from this list. This generates better-optimized CHECKs in official builds.
 enum class NotFatalUntil {
   NoSpecifiedMilestoneInternal = -1,
+#if BUILDFLAG(ARKWEB_UNITTESTS)
+  M114 = 114,
+  M115 = 115,
+#endif
   M120 = 120,
   M121 = 121,
   M122 = 122,
   M123 = 123,
