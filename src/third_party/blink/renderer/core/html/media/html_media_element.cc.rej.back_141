--- html_media_element.cc	2025-10-20 19:53:00.442209565 +0800
+++ html_media_element.cc	2025-10-21 21:23:47.826685956 +0800
@@ -4109,11 +4381,24 @@
 
     StartPlaybackProgressTimer();
     playing_ = true;
   } else {  // Should not be playing right now
     if (is_playing) {
+#if BUILDFLAG(ARKWEB_CUSTOM_VIDEO_PLAYER)
+      if (played_by_custom_mp_) {
+        web_media_player_->PauseWithReason(
+            media::ActionReason::kCustomRenderer);
+      } else {
+        web_media_player_->Pause();
+      }
+#else
       web_media_player_->Pause();
+#endif  // ARKWEB_CUSTOM_VIDEO_PLAYER
+
+#if BUILDFLAG(ARKWEB_VIDEO_ASSISTANT)
+      html_media_element_utils_.UpdatePlayStateOverlay(HTMLMediaElementUtils::PlayState::kPause);
+#endif
 
       if (pause_speech && ::features::IsTextBasedAudioDescriptionEnabled())
         SpeechSynthesis()->Pause();
     }
 
