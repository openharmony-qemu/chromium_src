diff a/third_party/blink/renderer/platform/loader/fetch/url_loader/mojo_url_loader_client.cc b/third_party/blink/renderer/platform/loader/fetch/url_loader/mojo_url_loader_client.cc	(rejected hunks)
@@ -381,21 +397,37 @@ void MojoURLLoaderClient::OnReceiveRedirect(
