--- chrome_browsing_data_remover_delegate.cc	2025-10-20 19:52:49.414612906 +0800
+++ chrome_browsing_data_remover_delegate.cc	2025-10-16 15:56:59.919039496 +0800
@@ -256,11 +256,15 @@
       << "|origin_type_mask| can only contain origin types defined in "
       << "the embedder.";
 
 #if BUILDFLAG(ENABLE_EXTENSIONS)
   // Packaged apps and extensions match iff EXTENSION.
-  if ((origin.scheme() == extensions::kExtensionScheme) &&
+  if ((origin.scheme() == extensions::kExtensionScheme
+#if BUILDFLAG(ARKWEB_ARKWEB_EXTENSIONS)
+       || origin.scheme() == extensions::kArkwebExtensionScheme
+#endif
+       ) &&
       (origin_type_mask & constants::ORIGIN_TYPE_EXTENSION)) {
     return true;
   }
   origin_type_mask &= ~constants::ORIGIN_TYPE_EXTENSION;
 #endif
