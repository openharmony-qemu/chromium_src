diff a/ui/accessibility/platform/browser_accessibility_manager.cc b/ui/accessibility/platform/browser_accessibility_manager.cc	(rejected hunks)
@@ -561,10 +563,16 @@ bool BrowserAccessibilityManager::OnAccessibilityEvents(
     defer_load_complete_event_ = false;
     FireBlinkEvent(ax::mojom::Event::kLoadComplete,
                    GetBrowserAccessibilityRoot(), -1);
   }
 
+#if BUILDFLAG(ARKWEB_ACCESSIBILITY)
+  if (details.events.empty() && GetBrowserAccessibilityRoot()) {
+    FireGeneratedEvent(AXEventGenerator::Event::NONE,
+                       GetBrowserAccessibilityRoot()->node());
+  }
