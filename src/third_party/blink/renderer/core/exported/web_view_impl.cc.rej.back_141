--- web_view_impl.cc	2025-10-20 19:53:00.362210324 +0800
+++ web_view_impl.cc	2025-10-16 16:07:39.377357245 +0800
@@ -3894,14 +3964,23 @@
 
   WebGestureEvent scaled_event =
       TransformWebGestureEvent(MainFrameImpl()->GetFrameView(), tap_event);
 
   HitTestResult result =
+#if BUILDFLAG(ARKWEB_MENU)
+      main_frame->GetEventHandler()
+          .HitTestResultForGestureEvent(scaled_event,
+                                        HitTestRequest::kReadOnly |
+                                            HitTestRequest::kActive |
+                                            HitTestRequest::kOnDoHitTest)
+          .GetHitTestResult();
+#else
       main_frame->GetEventHandler()
           .HitTestResultForGestureEvent(
               scaled_event, HitTestRequest::kReadOnly | HitTestRequest::kActive)
           .GetHitTestResult();
+#endif  // BUILDFLAG(ARKWEB_MENU)
 
   result.SetToShadowHostIfInUAShadowRoot();
   return result;
 }
 
