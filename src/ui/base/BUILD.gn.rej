+      import("//arkweb/chromium_ext/chromium_ext.gni")
+      sources += arkweb_ui_base_pointer_sources
     } else {
       # Empty implementation for all other cases.
       sources += [ "pointer/pointer_device.cc" ]
       sources -= [ "pointer/pointer_device_util.cc" ]
     }
