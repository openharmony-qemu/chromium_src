 # found in the LICENSE file.
 
 import("//build/config/ui.gni")
 import("//testing/test.gni")
+if(is_arkweb){
+  import("//arkweb/chromium_ext/chromium_ext.gni")
+}
 
 component("features") {
   output_name = "native_theme_features"
 
   defines = [ "NATIVE_THEME_IMPLEMENTATION" ]
@@ -75,10 +78,13 @@
     sources += [
       "native_theme_aura.cc",
       "native_theme_aura.h",
       "overlay_scrollbar_constants_aura.h",
     ]
+    if (is_arkweb) {
+      sources += arkweb_ui_native_theme_sources
+    }
   }
 
   defines = [ "NATIVE_THEME_IMPLEMENTATION" ]
 
   public_deps = [
@@ -160,17 +166,25 @@
       "caption_style_win_unittest.cc",
       "native_theme_win_unittest.cc",
     ]
   }
 
+  if (arkweb_unittests) {
+    sources += [
+      "//arkweb/chromium_ext/ui/native_theme/native_theme_aura_utils_unittest.cc",
+    ]
+    configs += ["//arkweb/chromium_ext:arkweb_system_properties_config"]
+  }
+
   deps = [
     ":native_theme",
     ":native_theme_browser",
     ":test_support",
     "//base/test:run_all_unittests",
     "//base/test:test_support",
     "//skia",
+    "//testing/gmock",
     "//testing/gtest",
     "//ui/base",
     "//ui/color",
     "//ui/gfx:test_support",
     "//ui/gfx/geometry:geometry",
