+#if BUILDFLAG(ARKWEB_NIGHT_MODE)
+static bool DrawNeedsLayer(const cc::PaintFlags& flags,
+                           const bool night_mode_enabled) {
+#else
 static bool DrawNeedsLayer(const cc::PaintFlags& flags) {
+#endif
   if (SkColorGetA(flags.getColor()) < 255)
     return true;
 
+#if BUILDFLAG(ARKWEB_NIGHT_MODE)
+  if (night_mode_enabled) {
+    return true;
