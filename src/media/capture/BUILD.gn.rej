--- BUILD.gn	2025-10-20 19:52:56.602199134 +0800
+++ BUILD.gn	2025-10-16 15:55:01.818212753 +0800
@@ -386,10 +390,30 @@
       "//third_party/fuchsia-sdk/sdk/fidl/fuchsia.camera3:fuchsia.camera3_hlcpp",
       "//third_party/fuchsia-sdk/sdk/pkg/sys_cpp",
       "//third_party/libyuv",
     ]
   }
+
+  if(is_arkweb) {
+    deps += [ "//arkweb/build/features" ]
+  }
+
+  if (enable_arkweb) {
+    deps += [ "//arkweb/build/features" ]
+  }
+
+  if (enable_arkweb) {
+    public_deps += [ "//arkweb/build/features" ]
+  }
+
+  if (arkweb_media_capture) {
+    import("//arkweb/chromium_ext/media/capture/video/ohos/arkweb_media_capture_video_ohos_ext.gni")
+    sources += arkweb_media_capture_video_ohos_sources
+    
+    include_dirs = ohos_src_includes
+    #libs = ["ohcamera"]
+  }
 }
 
 source_set("capture_gpu_channel") {
   defines = [ "CAPTURE_IMPLEMENTATION" ]
   sources = []
@@ -509,10 +533,18 @@
 
   if (enable_video_effects) {
     deps += [ "//components/viz/test:test_support" ]
   }
 
+  if (arkweb_unittests) {
+    import("//arkweb/chromium_ext/media/capture/video/ohos/arkweb_media_capture_video_ohos_ext.gni")
+
+    include_dirs = ohos_src_includes
+    deps += [ "//content/public/common:static_switches" ]
+    sources += arkweb_media_capture_video_ohos_unittests
+  }
+
   if (is_linux || is_chromeos_lacros) {
     sources += [
       "video/linux/v4l2_capture_delegate_unittest.cc",
       "video/linux/video_capture_device_factory_v4l2_unittest.cc",
     ]
