+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kEnableNwebEx)) {
+    return content::PreloadingEligibility::kEligible;
+  }
+#endif
+  return content::PreloadingEligibility::kPreloadingUnsupportedByWebContents;
 }
 
