assert(is_android || is_ohos)

if (is_android) {
source_set("ashmem") {
  sources = [
    "ashmem-dev.c",
    "ashmem.h",
  ]

  configs -= [ "//build/config/android:default_orderfile_instrumentation" ]
}
} else if(is_ohos) {
  source_set("ashmem") {
    sources = [
      "//arkweb/chromium_ext/third_party/ashmem/ohos_ashmem.cc",
      "ashmem.h",
    ]
    include_dirs = [
      "//third_party/ashmem"
    ]
  }
}
