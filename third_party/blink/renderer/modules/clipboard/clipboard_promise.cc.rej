diff a/third_party/blink/renderer/modules/clipboard/clipboard_promise.cc b/third_party/blink/renderer/modules/clipboard/clipboard_promise.cc	(rejected hunks)
@@ -714,10 +718,29 @@ void ClipboardPromise::ValidatePreconditions(
         FROM_HERE, blink::BindOnce(std::move(callback),
                                    mojom::blink::PermissionStatus::GRANTED));
