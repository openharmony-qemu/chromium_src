--- frame_sink_manager.mojom	2025-10-20 19:52:57.734211926 +0800
+++ frame_sink_manager.mojom	2025-10-16 15:55:03.424493631 +0800
@@ -211,18 +211,48 @@
   // Initializes FrameSinkManagerTestApi.
   [RuntimeFeature=EnableVizTestApis]
   EnableFrameSinkManagerTestApi(
       pending_receiver<FrameSinkManagerTestApi> receiver);
 
+  // Set Enable lower frame rate.
+  [EnableIf=arkweb_occluded_opt]
+  SetEnableLowerFrameRate(bool enabled, FrameSinkId frame_sink_id);
+
+  // Set Enable half frame rate.
+  [EnableIf=arkweb_occluded_opt]
+  SetEnableHalfFrameRate(bool enabled, FrameSinkId frame_sink_id);
+ 
+  // Set enable lower frame rate, because there is video playing with low frame rate and no touch event
+  [EnableIf=arkweb_video_ltpo]
+  UpdateVSyncFrequency(FrameSinkId frame_sink_id, uint32 client_id);
+ 
+  // Reset the frame rate after UpdateVSyncFrequency
+  [EnableIf=arkweb_video_ltpo]
+  ResetVSyncFrequency(FrameSinkId frame_sink_id);
+
+  [EnableIf=is_ohos]
+  SendInternalBeginFrame(FrameSinkId frame_sink_id);
+  // When frame is invisible, evict display back buffers
+  [EnableIf=arkweb_occluded_opt]
+  EvictFrameBackBuffers(FrameSinkId frame_sink_id);
+
+  // Set pip enable.
+  [EnableIf=arkweb_pip]
+  SetPipActive(bool active, FrameSinkId frame_sink_id);
+
   // Setup the connection between the Browser (at WebContentsImpl level) and
   // the VizCompositor thread (at InputManager level) to allow transferring
   // information from Viz to the Browser when the VizCompositor thread is
   // handling input using RenderInputRouters with InputVizard.
   SetupRenderInputRouterDelegateConnection(
     uint32 grouping_id,
     pending_remote<input.mojom.RenderInputRouterDelegateClient>
       rir_delegate_client_remote);
+
+  // set url
+  [EnableIf=arkweb_blank_optimize]
+  ClearBlanklessSnapshotInfo(uint64 blankless_key);
 };
 
 // The FrameSinkManagerClient interface is implemented by the Display
 // Compositor Host, a stable, and privileged peer service to the display
 // compositor. The frame sink manager host is either the browser process in
@@ -259,6 +289,10 @@
   // This is used to copy a screenshot after same-document navigation committed
   // in the renderer process.
   OnScreenshotCaptured(
       blink.mojom.SameDocNavigationScreenshotDestinationToken destination_token,
       CopyOutputResult copy_output_result);
+
+  // Send restore render fit callback to host client
+  [EnableIf=arkweb_maximize_resize]
+  RestoreRenderFit(uint32 client_id, uint32 sink_id);
 };
