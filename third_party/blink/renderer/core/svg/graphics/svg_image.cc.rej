diff a/third_party/blink/renderer/core/svg/graphics/svg_image.cc b/third_party/blink/renderer/core/svg/graphics/svg_image.cc	(rejected hunks)
@@ -652,17 +676,31 @@ void SVGImage::MaybeRecordSvgImageProcessingTime(const Document& document) {
     data_change_count_ = 0;
     data_change_elapsed_time_ = base::TimeDelta();
   }
