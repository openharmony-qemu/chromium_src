            << ", robustness=" << robustness
            << ", cdm_capability=" << (cdm_capability ? "yes" : "no");
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   DCHECK(pending_lazy_initializations_.count({key_system, robustness}));
