  public:
+#if BUILDFLAG(ARKWEB_EXT_DOWNLOAD)
+  friend class ArkWebBaseFileExt;
+  virtual ArkWebBaseFileExt* AsArkWebBaseFileExt() { return nullptr; }
+#endif
