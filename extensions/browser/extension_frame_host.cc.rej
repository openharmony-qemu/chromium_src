+              ChromeTrackEvent::kRenderProcessHost, *process);
+
+  MessageServiceApi::GetMessageService()->OpenChannelToBrowser(
+      render_frame_host->GetBrowserContext(), render_frame_host, port_id,
+      std::move(port), std::move(port_host));
+}
