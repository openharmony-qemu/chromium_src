--- fpdf_parser_utility.cpp	2025-10-20 19:53:19.587966399 +0800
+++ fpdf_parser_utility.cpp	2025-10-16 16:15:55.888621326 +0800
@@ -130,11 +130,11 @@
     dest_len = 0;
     for (const auto ch : src_span) {
       if (ch >= 0x80 || PDFCharIsWhitespace(ch) || ch == '#' ||
           PDFCharIsDelimiter(ch)) {
         dest_buf[dest_len++] = '#';
-        FXSYS_IntToTwoHexChars(ch, dest_buf.subspan(dest_len, 2u));
+        FXSYS_IntToTwoHexChars(ch, &dest_buf[dest_len]);
         dest_len += 2;
         continue;
       }
       dest_buf[dest_len++] = ch;
     }
