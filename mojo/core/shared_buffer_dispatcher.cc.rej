diff a/mojo/core/shared_buffer_dispatcher.cc b/mojo/core/shared_buffer_dispatcher.cc
--- a/mojo/core/shared_buffer_dispatcher.cc
+++ b/mojo/core/shared_buffer_dispatcher.cc
@@ -150,11 +150,11 @@ scoped_refptr<SharedBufferDispatcher> SharedBufferDispatcher::Deserialize(
     return nullptr;
   }
 
   PlatformHandle handles[2];
 #if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID) && \
-    !BUILDFLAG(MOJO_USE_APPLE_CHANNEL)
+    !BUILDFLAG(MOJO_USE_APPLE_CHANNEL) && !BUILDFLAG(IS_OHOS)
   if (serialized_state->access_mode ==
       MOJO_PLATFORM_SHARED_MEMORY_REGION_ACCESS_MODE_WRITABLE) {
     if (num_platform_handles != 2)
       return nullptr;
     handles[1] = std::move(platform_handles[1]);
@@ -274,11 +274,11 @@ MojoResult SharedBufferDispatcher::DuplicateBufferHandle(
