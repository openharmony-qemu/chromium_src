--- BUILD.gn	2025-10-20 19:52:56.570198640 +0800
+++ BUILD.gn	2025-10-16 15:55:01.786246965 +0800
@@ -453,10 +457,14 @@
       "libaom_thread_wrapper.h",
     ]
     deps += [ "//third_party/libaom" ]
   }
 
+  if (enable_arkweb) {
+    deps += [ "//arkweb//build/features" ]
+  }
+
   if (is_linux && !is_castos) {
     sources += [ "user_input_monitor_linux.cc" ]
   } else if (is_mac) {
     sources += [ "user_input_monitor_mac.cc" ]
     frameworks = [
@@ -720,10 +737,34 @@
   }
 
   if (is_castos) {
     sources += [ "demuxer_memory_limit_cast_unittest.cc" ]
   }
+
+  defines = []
+  if (arkweb_unittests) {
+    import("//arkweb/chromium_ext/chromium_ext.gni")
+    include_dirs = [
+      "//arkweb/ohos_adapter_ndk/interfaces",
+      "//third_party/ohos_ndk/includes/ohos_adapter"
+    ]
+    sources += arkweb_media_base_unittest_sources
+    sources += arkweb_media_adapter_unittest_sources
+    sources += arkweb_media_gpu_unittest_sources
+    sources += arkweb_media_filters_ohos_unittest_sources
+    sources += arkweb_media_third_party_unittest_sources
+    sources += arkweb_media_adapter_mock_sources
+    if (arkweb_enable_cdm) {
+      sources += arkweb_cdm_unittest_sources
+    }
+    sources += arkweb_media_mojo_services_unittest_sources
+    deps += [
+      "//arkweb/ohos_adapter_ndk:adapter_ndk",
+      "//content/test:test_support"
+    ]
+    defines += [ "IS_MEDIA_IMPL" ]
+  }
 }
 
