   DCHECK(!resolver_->ShouldForceSystemResolverDueToTestOverride());
 
+#if BUILDFLAG(ARKWEB_EXT_NAVIGATION) && BUILDFLAG(ARKWEB_EXT_HTTP_DNS_FALLBACK)
